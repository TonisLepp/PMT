{
  "manifest_version": 3,
  "name": "HLTV Post-Match Thread Tool",
  "description": "Creates HLTV live and post-match discussions with Liquipedia details. Schedule a PMT alone, or an LMT that updates and links to its automatic PMT.",
  "version": "2.7.2",
  "permissions": [
    "storage",
    "clipboardWrite",
    "scripting",
    "tabs",
    "alarms",
    "notifications",
    "tabGroups"
  ],
  "host_permissions": [
    "https://www.hltv.org/*",
    "https://liquipedia.net/*",
    "https://www.google.com/*",
    "https://search.brave.com/*",
    "https://old.reddit.com/*",
    "https://www.reddit.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "scripts": [
      "src/background.js",
      "src/scheduler.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "pmt-firefox@addons.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.hltv.org/matches/*"
      ],
      "js": [
        "src/log.js",
        "src/teams.js",
        "src/censor.js",
        "src/hltv.js",
        "src/liquipedia.js",
        "src/render.js",
        "src/content.js"
      ],
      "css": [
        "src/panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://old.reddit.com/r/*/submit*",
        "https://old.reddit.com/r/*/comments/*",
        "https://www.reddit.com/r/*/submit*",
        "https://www.reddit.com/r/*/comments/*"
      ],
      "js": [
        "src/reddit.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "src/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "HLTV Post-Match Thread"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
